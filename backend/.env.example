DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=job_tracker

# Local development can leave this blank. For remote MySQL, set this to the
# path of the provider's downloaded CA certificate file (keep it out of Git).
DB_SSL_CA=

# Replace with a unique secret generated using:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_this_later

# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: set to true only for local debugging.
FLASK_DEBUG=false
